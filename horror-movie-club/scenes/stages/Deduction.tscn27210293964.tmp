[sub_resource type="GDScript" id="GDScript_j05r2"]
script/source = "extends Control
class_name OrderedSlot

signal slot_filled(card_id: String)
signal slot_emptied

@export var slot_index: int = 0
var current_card_id: String = \"\"

func _ready() -> void:
	# Add each individual slot to the group so drag checks can find its specific bounds
	add_to_group(\"ordered_slots\")

func _can_drop_data(_at_position: Vector2, data: Variant) -> bool:
	return data is Control and (\"segment_identifier\" in data or data.has_method(\"get_segment_id\") or data.has_method(\"get_item_id\"))

func _drop_data(_at_position: Vector2, data: Variant) -> void:
	if not _can_drop_data(_at_position, data):
		return

	if \"is_dragging\" in data:
		data.is_dragging = false

	# Extract card ID
	var incoming_id: String = \"\"
	if \"segment_identifier\" in data:
		incoming_id = str(data.segment_identifier)
	elif data.has_method(\"get_segment_id\"):
		incoming_id = data.get_segment_id()
	elif data.has_method(\"get_item_id\"):
		incoming_id = data.get_item_id()

	# Return existing card in this slot back to pool if swapped
	for child in get_children():
		if child is Control and child != data and (\"segment_identifier\" in child or child.has_method(\"get_segment_id\")):
			remove_child(child)
			var pool = get_tree().get_first_node_in_group(\"segment_pool\")
			if pool:
				pool.add_child(child)
			else:
				get_tree().current_scene.add_child(child)
			slot_emptied.emit()
			break

	# Reparent card into THIS specific slot instance
	if data.get_parent():
		data.get_parent().remove_child(data)

	add_child(data)

	# Center card inside this slot frame
	if data is Control:
		data.set_anchors_preset(Control.PRESET_TOP_LEFT)
		data.position = (size - data.size) / 2.0

	current_card_id = incoming_id
	slot_filled.emit(current_card_id)
	print(\"Slot \", slot_index, \" successfully received card ID: \", current_card_id)

func get_item_id() -> String:
	return current_card_id
"

